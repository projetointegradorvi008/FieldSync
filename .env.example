# ── Geral ──────────────────────────────────────────────────────
NODE_ENV=development
VERSION=latest

# ── Imagens Docker (Modo 3 — VPS, ver docker-compose.prod.yml) ──
# Precisa ser IDÊNTICO a `github.repository` do repositório no GitHub
# (owner/nome-do-repo, tudo minúsculo) — é o mesmo valor usado por
# `.github/workflows/deploy.yml` ao publicar `ghcr.io/<GHCR_REPOSITORY>/backend`
# e `.../web`. Deixar "seu-org/..." aqui faz o `docker compose ... pull`
# falhar (imagem inexistente) e o deploy nunca sobe.
GHCR_REPOSITORY=seu-usuario/fieldsync

# ── Tailscale (container, ver serviço `tailscale`) ──────────────
# Chave de autenticação gerada em
# https://login.tailscale.com/admin/settings/keys (reusable, sem
# expiração, é o mais prático para um servidor de longa duração) — cola
# aqui e o serviço `tailscale` entra sozinho no tailnet ao subir o Docker.
# Só necessária no Linux (ver comentário do serviço no docker-compose.yml).
TS_AUTHKEY=

# ── Banco de Dados ─────────────────────────────────────────────
POSTGRES_DB=fieldsync
POSTGRES_USER=fieldsync_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgresql://fieldsync_user:CHANGE_ME@postgres:5432/fieldsync

# ── Autenticação (JWT) ─────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_chars_random_string_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs públicas ──────────────────────────────────────────────
# LOCAL (Tailscale): usar IP do servidor (ex: 100.64.0.1)
# VPS: usar domínio público
API_URL=http://100.64.0.1/api
NEXT_PUBLIC_API_URL=http://100.64.0.1/api

# ── Comunicação server-side Web -> Backend (BFF) ────────────────
# Usado apenas pelos Route Handlers do Next.js (nunca chega ao browser).
# Docker: http://backend:3001 · fora do Docker: http://localhost:3001
BACKEND_INTERNAL_URL=http://backend:3001

# ── Mobile (apps/mobile/.env — prefixo EXPO_PUBLIC_ obrigatório) ─
# Mesmo valor de API_URL acima (IP Tailscale do servidor + /api).
EXPO_PUBLIC_API_URL=http://100.64.0.1/api

# IP Tailscale/LAN da máquina que roda o Docker (o mesmo host de API_URL,
# sem porta) — usado pelo serviço `mobile` (docker-compose.dev.yml) para que
# o Metro bundler anuncie um endereço alcançável pelo celular, em vez do IP
# interno do container.
MOBILE_LAN_IP=100.64.0.1

# URL exp:// exibida como QR code na aba de Sessões (web) para parear um
# dispositivo pela primeira vez — mesmo host de MOBILE_LAN_IP, porta 8081
# (Metro, ver serviço `mobile`).
EXPO_DEV_SERVER_URL=exp://100.64.0.1:8081

# ── Segurança (revisão OWASP) ──────────────────────────────────
# Origem(ns) do Front-End Web autorizadas a chamar o Backend via CORS,
# separadas por vírgula. Nunca usar "*" (o Backend usa credentials: true).
CORS_ORIGIN=http://localhost:3000

# ── Administrador (obrigatório só quando NODE_ENV=production) ───
# Em produção (local ou VPS), `prisma db seed` cria só este usuário
# ADMINISTRADOR — nenhum dado de exemplo. A senha precisa ter no mínimo 16
# caracteres, misturar maiúsculas/minúsculas/números-ou-símbolos, e nunca
# pode ser a senha de desenvolvimento (admin123456) — o boot do Backend e o
# seed recusam subir/rodar caso contrário. Gere uma só sua e guarde-a (ela
# nunca é impressa em log): ex. `openssl rand -base64 24`.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@fieldsync.local
